# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and must NEVER be committed.

# ── Auth (Clerk) ──────────────────────────────────────────────
# Get these from https://dashboard.clerk.com after creating an app
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ── AI Coaching (Anthropic / Claude) ─────────────────────────
# Get this from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# ── Cloudflare (local dev only — handled by wrangler in prod) ─
# These are set automatically when using `npx wrangler pages dev`
# CF_PAGES=1
